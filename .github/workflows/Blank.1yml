name: Windows x86

on:
  workflow_dispatch:

jobs:
  build-x86:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          targets: i686-pc-windows-msvc
      - run: cargo build --release --target i686-pc-windows-msvc -p vera20k
